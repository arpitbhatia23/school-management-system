# Copy this file to .env and fill in real values. Do NOT commit secrets to the repository.

# Environment (development | production)
NODE_ENV=development

# Server
PORT=8080
CORS_ORIGIN=http://localhost:3000

# MongoDB (replace <username>, <password>, and <cluster-url> as needed)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net

# Cloudinary
CLOUDNAME=your_cloud_name
APIKEY=your_cloudinary_api_key
APISECRETKEY=your_cloudinary_api_secret

# JWT (use long random secrets in production)
ACCESSTOKENSECRET=replace_with_access_token_secret
ACCESSTOKENEXPIRY=15m
REFRESHTOKENSECRET=replace_with_refresh_token_secret
REFRESHTOKENEXPIRY=7d

# Twilio (for SMS notifications)
AccountSid=your_twilio_account_sid
AuthToken=your_twilio_auth_token
TwilioPhoneNumber=+1234567890

# Cookie options (set to true in production)
COOKIE_SECURE=false

# Notes:
# - Copy this file to backend/.env (or to your environment) and populate the values.
# - For local testing you can run MongoDB locally and set MONGODB_URL to mongodb://localhost:27017
# - Keep secrets out of version control. Add backend/.env to .gitignore if not present.
